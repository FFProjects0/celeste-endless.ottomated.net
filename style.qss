/* 1. Global & Window Background */
QMainWindow, QWidget {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #1a1a1a, stop: 1 #121212
    );                                             /* vertical gradient */ :contentReference[oaicite:0]{index=0}
    color: #e0e0e0;                                /* default text color */
}

/* 2. Typography */
/* 2.1 Main Title */
QLabel#title_label {
    font-family: "Montserrat", Arial, sans-serif;
    font-size: 18pt;
    font-weight: bold;
    color: #ffffff;
}
/* 2.2 Subtitle */
QLabel#subtitle_label {
    font-family: "Montserrat", Arial, sans-serif;
    font-size: 10pt;
    color: #aaaaaa;
}
/* 2.3 Links */
QLabel[openExternalLinks="true"] {
    color: #ff5ac3;                                /* neon‑pink links */
}
QLabel[openExternalLinks="true"]:hover {
    color: #d12294;                                /* darker hover */ :contentReference[oaicite:1]{index=1}
}

/* 3. Buttons (QPushButton) */
QPushButton {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #ff5ac3, stop: 1 #a458ed
    );                                             /* horizontal neon gradient */ :contentReference[oaicite:2]{index=2}
    border: none;
    border-radius: 6px;
    padding: 8px 16px;
    color: #ffffff;
    font-weight: bold;
}
QPushButton:hover {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #ff7adf, stop: 1 #c27bed
    );
}
QPushButton:pressed {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #d12294, stop: 1 #7b30b0
    );
}

/* 4. Spin Boxes (QSpinBox) */
QSpinBox {
    background-color: #222222;
    border: 1px solid #444444;
    border-radius: 4px;
    color: #ffffff;
    padding: 2px 4px;
}
QSpinBox::up-button, QSpinBox::down-button {
    background: transparent;
    subcontrol-origin: border;
    subcontrol-position: top right, bottom right;
}
QSpinBox::up-arrow, QSpinBox::down-arrow {
    image: none;
}

/* 5. Separators & Frames */
QFrame {
    background-color: transparent;
    color: #444444;
}
QFrame[frameShape="4"] {                           /* HLine */
    background-color: #444444;
    height: 1px;
    margin: 8px 0;
}

/* 6. Scrollbars (QScrollBar) */
QScrollBar:vertical {
    background: transparent;
    width: 12px;
    margin: 16px 0 16px 0;
}
QScrollBar::handle:vertical {
    background: #555555;                          /* default thumb */ :contentReference[oaicite:3]{index=3}
    min-height: 30px;
    border-radius: 6px;
}
QScrollBar::handle:vertical:hover {
    background: #777777;                          /* hover thumb */
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    background: transparent;
    height: 0;
    subcontrol-origin: margin;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}
